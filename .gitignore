# Dependencies
node_modules/
package-lock.json.bak

# SQLite database (your worklog data — back this up separately, don't commit it)
# The -wal / -shm files are transient and must never be committed.
worklog.db
worklog.db-wal
worklog.db-shm
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

